{
  "name": "MCP45HVX1",
  "version": "1.0.0",
  "description": "Framework-neutral MCP45HVX1 high-voltage I2C digital potentiometer driver.",
  "keywords": [
    "mcp45hvx1",
    "mcp45hv31",
    "mcp45hv51",
    "digital-potentiometer",
    "digipot",
    "i2c",
    "esp32",
    "arduino",
    "espidf",
    "esp-idf",
    "platformio"
  ],
  "authors": [
    {
      "name": "Thymos Solution s.r.o",
      "email": "info@thymos.cz",
      "url": "https://www.thymos.cz"
    },
    {
      "name": "Jan Havelka",
      "email": "info@thymos.cz",
      "url": "https://www.thymos.cz",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/janhavelka/MCP45HVX1.git"
  },
  "license": "MIT",
  "homepage": "https://www.thymos.cz",
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "platforms": [
    "espressif32"
  ],
  "headers": [
    "MCP45HVX1/MCP45HVX1.h"
  ],
  "build": {
    "includeDir": "include",
    "srcDir": "src"
  },
  "export": {
    "include": [
      "include/**",
      "src/**",
      "examples/**",
      "scripts/generate_version.py",
      "CMakeLists.txt",
      "idf_component.yml",
      "library.json",
      "platformio.ini",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "SECURITY.md",
      "CONTRIBUTING.md",
      "ASSUMPTIONS.md",
      "MCP45HVX1_digital_potentiometer_implementation_manual.md",
      "docs/IDF_PORT.md",
      "docs/IDF_PORT_IMPLEMENTATION.md",
      "docs/MCP45HVX1_API_CONTRACT.md",
      "docs/MCP45HVX1_HARDWARE_VALIDATION.md",
      "docs/hardware_validation.md",
      "docs/MCP45HVX1_RELEASE_CHECKLIST.md",
      "docs/MCP45HVX1_DEVICE_MODEL_ERRATA_REPORT.md",
      "docs/MCP45HVX1_DOCS_RELEASE_METADATA_REPORT.md"
    ],
    "exclude": [
      ".github/**",
      ".pio/**",
      "test/**",
      "tests/**",
      "tools/**",
      "docs/*.pdf",
      "docs/extracted-md/**",
      "docs/pdf-extracted-md/**"
    ]
  }
}
